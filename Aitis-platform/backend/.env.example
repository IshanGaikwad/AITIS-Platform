# ── Application ──────────────────────────────────────────────
APP_NAME=AI Test Intelligence API
APP_ENV=development
API_V1_PREFIX=/api

# ── Database — PostgreSQL with asyncpg ───────────────────────
DATABASE_URL=postgresql+asyncpg://aitis:aitis_dev_password@localhost:5432/aitis

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Authentication ───────────────────────────────────────────
# SECRET_KEY MUST be changed in production — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OAuth2 SSO ───────────────────────────────────────────────
# Choose provider: auth0, google, microsoft, github, atlassian
OAUTH2_PROVIDER=atlassian
OAUTH2_CLIENT_ID=your-client-id
OAUTH2_CLIENT_SECRET=your-client-secret
# Auth0 domain (required if provider=auth0)
OAUTH2_DOMAIN=your-tenant.auth0.com
# Microsoft tenant ID (required if provider=microsoft)
OAUTH2_TENANT_ID=your-tenant-id
# Atlassian audience (required if provider=atlassian)
OAUTH2_AUDIENCE=api.atlassian.com
# Atlassian scopes (required if provider=atlassian)
OAUTH2_SCOPES=read:jira-work read:confluence-content.all
OAUTH2_REDIRECT_URI=http://localhost:3000/auth/callback

# ── Jira Integration ────────────────────────────────────────
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token

# ── S3-compatible Storage (execution artifacts) ─────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio-access-key
S3_SECRET_KEY=minio-secret-key
S3_BUCKET_NAME=aitis-artifacts
