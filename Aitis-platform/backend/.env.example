# Jira Configuration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token

# Database
DATABASE_URL=sqlite:///./app.db

# Authentication
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OAuth2 SSO Configuration
OAUTH2_PROVIDER=atlassian  # auth0, google, microsoft, github, atlassian
OAUTH2_CLIENT_ID=your-atlassian-client-id
OAUTH2_CLIENT_SECRET=your-atlassian-client-secret
OAUTH2_DOMAIN=your-domain.auth0.com  # For Auth0 (optional)
OAUTH2_TENANT_ID=your-tenant-id  # For Microsoft (optional)
OAUTH2_AUDIENCE=api.atlassian.com  # For Atlassian
OAUTH2_SCOPES=read:jira-work read:confluence-content.all
OAUTH2_REDIRECT_URI=http://localhost:3000/auth/callback

# Environment
ENV=development
