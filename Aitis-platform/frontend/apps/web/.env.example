# ── Frontend Environment ─────────────────────────────────────
# Backend base URL used by the Next.js rewrites proxy (next.config.mjs) and by
# server-side rendering in lib/api.ts. The browser always calls relative /api/*
# paths, which Next.js proxies to this URL — so there are no CORS issues.
# Must NOT include a trailing /api. Default backend port is 8001.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
